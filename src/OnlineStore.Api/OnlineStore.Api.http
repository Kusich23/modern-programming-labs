@OnlineStore_Api_HostAddress = http://localhost:5150

### Get OpenAPI specification
GET {{OnlineStore_Api_HostAddress}}/openapi/v1.json
Accept: application/json

### Get all orders
GET {{OnlineStore_Api_HostAddress}}/orders
Accept: application/json

### Filter orders by status=Paid
GET {{OnlineStore_Api_HostAddress}}/orders?status=Paid
Accept: application/json

### Get order by Id (200 OK)
GET {{OnlineStore_Api_HostAddress}}/orders/33333333-3333-3333-3333-333333333331
Accept: application/json

### Get missing order (404 Not Found)
GET {{OnlineStore_Api_HostAddress}}/orders/99999999-9999-9999-9999-999999999999
Accept: application/json

### Create a new order (201 Created)
POST {{OnlineStore_Api_HostAddress}}/orders
Content-Type: application/json

{
  "customerId": "11111111-1111-1111-1111-111111111111",
  "items": [
    {
      "productId": "22222222-2222-2222-2222-222222222222",
      "quantity": 2
    },
    {
      "productId": "22222222-2222-2222-2222-222222222223",
      "quantity": 1
    }
  ]
}

### Create invalid order with negative quantity (400 Bad Request)
POST {{OnlineStore_Api_HostAddress}}/orders
Content-Type: application/json

{
  "customerId": "11111111-1111-1111-1111-111111111111",
  "items": [
    {
      "productId": "22222222-2222-2222-2222-222222222222",
      "quantity": -1
    }
  ]
}

### Pay Created order (200 OK)
POST {{OnlineStore_Api_HostAddress}}/orders/33333333-3333-3333-3333-333333333331/pay
Accept: application/json

### Pay already Paid order (409 Conflict)
POST {{OnlineStore_Api_HostAddress}}/orders/33333333-3333-3333-3333-333333333332/pay
Accept: application/json

### Pay Cancelled order (409 Conflict)
POST {{OnlineStore_Api_HostAddress}}/orders/33333333-3333-3333-3333-333333333333/pay
Accept: application/json

### Pay missing order (404 Not Found)
POST {{OnlineStore_Api_HostAddress}}/orders/99999999-9999-9999-9999-999999999999/pay
Accept: application/json

### ================= RETURNS MODULE =================

### Get all return requests
GET {{OnlineStore_Api_HostAddress}}/returns
Accept: application/json

### Get return request by Id (replace with created id, 200 OK or 404 Not Found)
GET {{OnlineStore_Api_HostAddress}}/returns/99999999-9999-9999-9999-999999999999
Accept: application/json

### Create return request for a Paid order (201 Created)
POST {{OnlineStore_Api_HostAddress}}/returns
Content-Type: application/json

{
  "orderId": "33333333-3333-3333-3333-333333333332",
  "reason": "Defective scroll wheel",
  "items": [
    {
      "productName": "Wireless Mouse",
      "quantity": 1,
      "unitPrice": 1200
    }
  ]
}

### Create invalid return request with quantity <= 0 (400 Bad Request)
POST {{OnlineStore_Api_HostAddress}}/returns
Content-Type: application/json

{
  "orderId": "33333333-3333-3333-3333-333333333332",
  "reason": "Wrong item",
  "items": [
    {
      "productName": "Wireless Mouse",
      "quantity": 0,
      "unitPrice": 1200
    }
  ]
}

### Create return request for missing order (404 Not Found)
POST {{OnlineStore_Api_HostAddress}}/returns
Content-Type: application/json

{
  "orderId": "99999999-9999-9999-9999-999999999999",
  "reason": "Missing order",
  "items": [
    {
      "productName": "Wireless Mouse",
      "quantity": 1,
      "unitPrice": 1200
    }
  ]
}

### Approve return request (200 OK, or 409 Conflict if already Approved/Rejected)
POST {{OnlineStore_Api_HostAddress}}/returns/99999999-9999-9999-9999-999999999999/approve
Accept: application/json

### Reject return request (200 OK, or 409 Conflict if already Approved/Rejected)
POST {{OnlineStore_Api_HostAddress}}/returns/99999999-9999-9999-9999-999999999999/reject
Accept: application/json
